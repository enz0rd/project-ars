# Project Ars — copy to .env for local development (never commit the real file).

# --- Browser (public; bundled into the app) ---------------------------------
# Supabase project URL and its publishable/anon key. Safe to expose: every query
# is limited by row level security.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Show "Continue with GitHub" (enable the GitHub provider in Supabase Auth first).
# VITE_AUTH_GITHUB=true
# Link to the source code on the sign-in page.
# VITE_REPO_URL=https://github.com/you/project-ars

# --- Server (secret; Vercel → Project → Settings → Environment Variables) ----
SUPABASE_URL=http://127.0.0.1:54321
# Bypasses row level security. Server only — never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Encrypts users' AI keys and MCP server tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes saved keys unreadable (users re-enter them); leaking it exposes them.
ARS_ENCRYPTION_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# PORT=8787
# Single-user local installs only: lets MCP import_image read files from this machine.
# ARS_ALLOW_LOCAL_FILES=1
